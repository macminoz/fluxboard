# systemd unit for an LXC, VM or Raspberry Pi. Assumes the project in /opt/fluxboard and a service
# user "fluxboard" owning the config/ and cache/ folders. Port 80 without root thanks to
# CAP_NET_BIND_SERVICE; for another port change FLUXBOARD_PORT.
[Unit]
Description=Fluxboard
After=network-online.target
Wants=network-online.target

[Service]
User=fluxboard
WorkingDirectory=/opt/fluxboard
Environment=FLUXBOARD_PORT=80
ExecStart=/usr/bin/node server/index.js
Restart=always
RestartSec=5
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/fluxboard/config /opt/fluxboard/cache

[Install]
WantedBy=multi-user.target
