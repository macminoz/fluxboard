# Unità systemd per LXC, VM o Raspberry Pi. Presuppone il progetto in /opt/fluxboard
# e un utente di servizio "fluxboard" proprietario delle cartelle config/ e cache/.
# Porta 80 senza root grazie a CAP_NET_BIND_SERVICE; per un'altra porta cambiare FLUXBOARD_PORT.
[Unit]
Description=Fluxboard
After=network-online.target
Wants=network-online.target

[Service]
User=fluxboard
WorkingDirectory=/opt/fluxboard
Environment=FLUXBOARD_PORT=80
ExecStart=/usr/bin/node server/index.js
Restart=always
RestartSec=5
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/fluxboard/config /opt/fluxboard/cache

[Install]
WantedBy=multi-user.target
